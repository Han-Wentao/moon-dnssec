// Independent signatures generated by Node.js OpenSSL. Only public material is retained.

///|
test "OpenSSL external algorithm 8 authenticates and detects changed message" {
  let key = Dnskey::parse(
    b"\x01\x01\x03\x08\x03\x01\x00\x01\xdb\xf9\xbf\x76\xea\xb0\x45\x37\x31\xb4\xc7\x9d\x1b\x7a\x2a\x2a\x11\x1e\xce\x88\x53\x39\x5f\x0f\x1e\x29\x0a\xdd\x47\xad\xfe\x9c\x71\x27\x58\x6e\x09\x31\xd5\xa4\xb7\x59\x67\xf9\x97\xcb\x61\xaf\xdd\x03\x12\x6b\x99\xeb\x57\x0b\xa2\xe0\xb1\xc3\x18\x57\x15\x13\xe3\x1c\x96\x34\xfc\x0f\x21\x97\x95\x80\x2c\x04\xf8\x8a\x41\x6d\x11\xe6\x0c\xa4\x8c\x4c\x6d\xc7\x97\x8f\xe6\x76\x0b\x6d\x2e\xec\x68\x8f\x32\xb1\x7f\xb3\x7b\x75\x1a\x25\x99\xc3\x55\x1a\x1d\x94\x9b\x02\xcf\x93\x2a\x20\x1f\x1a\x46\x40\xbc\xa5\x18\x1e\x7e\x89",
  ).unwrap()
  let sig = b"\x38\xd3\x1a\x82\x08\xc3\xef\xa9\x66\xde\x0c\x39\x25\x40\x5d\x10\x89\x70\x1d\x7b\x29\x44\xe1\x9f\x5e\x3b\x1e\x82\xe2\xec\xc7\xa9\x19\x3b\x16\x9c\x9f\x5f\x73\x9a\x89\xe8\xbe\xa2\xa1\x22\x16\x4a\x9d\x56\x1e\xc4\x4e\x6b\x11\x2b\x7a\xca\x7e\x90\xca\x88\x1d\xb1\xe6\x6f\x8d\xfd\x74\xd0\xc5\xe8\x47\x11\x17\xa1\x93\x1f\x27\x76\x0b\x03\xcc\xdd\xf6\x2d\x8f\x87\x4c\xa6\xdf\x0d\x5c\x0b\x56\xe9\x61\xc6\xbc\xfd\x4f\x2c\x5e\x62\xaa\xac\x52\x9a\x0e\xee\x44\xe4\xbf\x64\x91\xcd\xd1\x11\x2a\x64\xc0\xc1\x8e\x3e\xfb\x48\x77\x1a"
  assert_eq(
    verify_signature(
      key, b"\x49\x6e\x64\x65\x70\x65\x6e\x64\x65\x6e\x74\x20\x44\x4e\x53\x53\x45\x43\x20\x61\x64\x61\x70\x74\x65\x72\x20\x74\x65\x73\x74",
      sig,
    ),
    Ok(true),
  )
  assert_eq(verify_signature(key, b"changed", sig), Ok(false))
  assert_true(verify_signature(key, b"changed", b"x") is Err(_))
}

