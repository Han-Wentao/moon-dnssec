///|
fn fixture_trust() -> TrustedKeys {
  let zone = Name::parse("example.").unwrap()
  let key = Dnskey::parse(
    b"\x01\x01\x03\x0f\x26\xcf\xcd\x3b\x19\x35\xd0\x89\x7e\x65\x40\x0d\x1d\xd8\x66\x5b\xc9\x5f\x21\xb7\x63\x74\x9f\xd4\x21\xc1\x2d\x57\xcf\x97\x61\xb7",
  ).unwrap()
  let rr = Record::new(zone, 48, 60U, key.rdata()).unwrap()
  let sig = Rrsig::parse(
    b"\x00\x30\x0f\x01\x00\x00\x00\x3c\x00\x00\x00\xc8\x00\x00\x00\x64\x93\x47\x07\x65\x78\x61\x6d\x70\x6c\x65\x00\xc7\xa7\x4b\x37\x28\x94\xe1\x1f\x8e\x15\x5e\xe9\x16\x53\x3e\xd2\xa8\x7a\x5e\x99\xda\x50\x29\x4a\xa6\x66\xfb\x57\x0b\x57\x83\x2e\x2e\x67\x1b\x30\xd7\xcb\x64\x32\xef\x7d\x43\x93\xf0\x66\x7c\x8c\xf0\xc9\xc0\x1a\x75\x4e\xe5\xb5\x14\xc7\x51\xa2\xcc\xad\xcc\x08",
  ).unwrap()
  anchor_keys(zone, key, [rr], [sig], TimePolicy::at(150U), Limits::default()).unwrap()
}

///|
test "anchor authenticates complete DNSKEY set and freshness expires" {
  let trust = fixture_trust()
  assert_eq(trust.depth(), 0)
  assert_eq(trust.remaining(150U), Ok(50U))
  assert_true(trust.remaining(200U) is Err(Stale(_)))
  assert_true(trust.remaining(149U) is Err(Stale(_)))
  let zone = trust.zone()
  let key = Dnskey::parse(
    b"\x01\x01\x03\x0f\x26\xcf\xcd\x3b\x19\x35\xd0\x89\x7e\x65\x40\x0d\x1d\xd8\x66\x5b\xc9\x5f\x21\xb7\x63\x74\x9f\xd4\x21\xc1\x2d\x57\xcf\x97\x61\xb7",
  ).unwrap()
  let rr = Record::new(zone, 48, 60U, key.rdata()).unwrap()
  let sig = Rrsig::parse(
    b"\x00\x30\x0f\x01\x00\x00\x00\x3c\x00\x00\x00\xc8\x00\x00\x00\x64\x93\x47\x07\x65\x78\x61\x6d\x70\x6c\x65\x00\xc7\xa7\x4b\x37\x28\x94\xe1\x1f\x8e\x15\x5e\xe9\x16\x53\x3e\xd2\xa8\x7a\x5e\x99\xda\x50\x29\x4a\xa6\x66\xfb\x57\x0b\x57\x83\x2e\x2e\x67\x1b\x30\xd7\xcb\x64\x32\xef\x7d\x43\x93\xf0\x66\x7c\x8c\xf0\xc9\xc0\x1a\x75\x4e\xe5\xb5\x14\xc7\x51\xa2\xcc\xad\xcc\x08",
  ).unwrap()
  assert_true(
    authenticate_rrset(
      [rr],
      [sig],
      trust,
      TimePolicy::at(150U),
      Limits::default(),
    )
    is Ok(_),
  )
}
