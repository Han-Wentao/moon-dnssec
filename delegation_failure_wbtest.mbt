///|
test "valid parent signatures cannot hide DS mismatch or unsupported digest" {
  let parent = fixture_trust()
  let child = Name::parse("child.example.").unwrap()
  let key = Record::new(
    child, 48, 60U, b"\x01\x01\x03\x0f\xce\x7f\x68\x90\x0c\xd8\x86\xbf\x7a\x24\xd4\xe8\xb3\x59\xa3\xb2\xac\x11\x92\xd2\x71\xa3\x20\xc9\x9a\x01\xde\x68\xa8\x25\xf2\x8e",
  ).unwrap()
  let sig = Rrsig::parse(
    b"\x00\x30\x0f\x02\x00\x00\x00\x3c\x00\x00\x00\xc8\x00\x00\x00\x64\x59\x41\x05\x63\x68\x69\x6c\x64\x07\x65\x78\x61\x6d\x70\x6c\x65\x00\x20\xbf\x34\x93\xda\x29\xe8\xbd\x72\x9d\x48\x54\xbc\x50\xd4\x0c\x80\x5b\x45\xba\x21\x1b\xdf\x1a\x0d\x18\x7e\x99\xe7\x80\xea\x7f\xa3\x14\xd9\x4f\x0a\x61\x78\x1b\xb6\x81\x66\xc1\x4d\xa6\xe7\x89\x7d\xb6\xf4\x81\x4b\x2d\x44\xee\xc9\xd6\x5c\x2b\xfc\xe9\x78\x05",
  ).unwrap()
  let wrong = Record::new(
    child, 43, 60U, b"\x59\x41\x0f\x02\x3e\xf1\x1e\xa3\xa7\x12\x23\x6c\x13\x40\x40\x43\x68\xe4\xc6\x0a\xa9\x34\x95\x7b\xb8\x58\x8c\x68\x3f\x26\x3f\x96\xd1\xae\x61\x58",
  ).unwrap()
  let wrongsig = Rrsig::parse(
    b"\x00\x2b\x0f\x02\x00\x00\x00\x3c\x00\x00\x00\xc8\x00\x00\x00\x64\x93\x47\x07\x65\x78\x61\x6d\x70\x6c\x65\x00\x84\x87\x6f\x51\xfa\xda\xa0\xc4\x16\xa0\x3c\x41\x25\x36\x08\x4a\xab\xe0\x99\x91\xae\xc1\x62\x80\x57\x53\xf9\x6a\xf1\xfc\xda\xe1\xf4\x1b\x6c\xfc\xb7\x02\x59\x33\x3e\xba\x6f\xe3\x9d\x5d\x87\x4d\xcb\x45\x56\x54\x65\xbb\x01\x47\x9f\x1c\x58\x68\xf7\xb5\xaa\x02",
  ).unwrap()
  assert_true(
    delegate_keys(
      parent,
      child,
      [wrong],
      [wrongsig],
      [key],
      [sig],
      TimePolicy::at(150U),
      Limits::default(),
    )
    is Err(Bogus(_)),
  )
  let unknown = Record::new(
    child, 43, 60U, b"\x59\x41\x0f\xff\x3e\xf1\x1e\xa3\xa7\x12\x23\x6c\x13\x40\x40\x43\x68\xe4\xc6\x0a\xa9\x34\x95\x7b\xb8\x58\x8c\x68\x3f\x26\x3f\x96\xd1\xae\x61\x59",
  ).unwrap()
  let unknownsig = Rrsig::parse(
    b"\x00\x2b\x0f\x02\x00\x00\x00\x3c\x00\x00\x00\xc8\x00\x00\x00\x64\x93\x47\x07\x65\x78\x61\x6d\x70\x6c\x65\x00\x30\x40\x35\x33\x72\x91\xf1\xc6\x7f\x1b\xe4\xca\x66\xc7\x4e\xf8\x46\xd5\x68\x58\x1f\xbf\x7b\x0c\x8f\x98\x2f\xae\xb1\x25\xa7\xe1\xb9\x0e\x84\xdc\x12\x0d\x58\xf8\x40\xbc\xbf\xd9\x4a\x7d\xea\xdb\x42\x44\x6f\x81\x8c\xfe\xe6\x2d\x68\x91\x4d\x55\xec\xee\x6e\x03",
  ).unwrap()
  assert_true(
    delegate_keys(
      parent,
      child,
      [unknown],
      [unknownsig],
      [key],
      [sig],
      TimePolicy::at(150U),
      Limits::default(),
    )
    is Err(Unsupported(_)),
  )
  assert_true(
    delegate_keys(
      parent,
      child,
      [],
      [],
      [key],
      [sig],
      TimePolicy::at(150U),
      Limits::default(),
    )
    is Err(Indeterminate(_)),
  )
  assert_true(
    delegate_keys(
      { ..parent, depth: 16, },
      child,
      [],
      [],
      [key],
      [sig],
      TimePolicy::at(150U),
      Limits::default(),
    )
    is Err(ResourceLimit(_)),
  )
}
