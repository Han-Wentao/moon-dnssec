///|
test "independent Ed25519 DNSSEC fixture authenticates RRset and bounds lifetime" {
  let zone = Name::parse("example.").unwrap()
  let key = Dnskey::parse(
    b"\x01\x01\x03\x0f\x70\x27\xd6\x3f\xf7\x66\x45\x7d\x2c\x51\xa0\x2d\xb5\x4f\x98\xa2\x4c\x22\xef\xfb\xb5\xa3\xef\x30\x18\xc9\x74\xa8\x28\x3b\x64\x6a",
  ).unwrap()
  let sig = Rrsig::parse(
    b"\x00\x01\x0f\x01\x00\x00\x00\x3c\x00\x00\x00\xc8\x00\x00\x00\x64\x9c\xd6\x07\x65\x78\x61\x6d\x70\x6c\x65\x00\x17\x32\x80\x1a\xf4\x4d\x18\xae\xef\x15\x3a\x11\xbc\xb6\x91\x79\x53\xcd\x6f\x57\x54\x52\xb9\x14\x19\x52\x73\xe9\x7c\xcd\x32\xbf\x03\x5a\xf3\x37\x2b\x8e\x0e\x21\xf4\x7e\x79\x1c\xad\x71\xfc\xde\xb9\x2f\xdb\xbf\x84\x0d\x6b\xe8\x8c\xe4\x02\x8b\xc7\xb0\xa1\x0f",
  ).unwrap()
  let rr = Record::new(zone, 1, 30U, b"\xc0\x00\x02\x01").unwrap()
  assert_eq(
    signing_input([rr], sig, Limits::default()).unwrap(),
    b"\x00\x01\x0f\x01\x00\x00\x00\x3c\x00\x00\x00\xc8\x00\x00\x00\x64\x9c\xd6\x07\x65\x78\x61\x6d\x70\x6c\x65\x00\x07\x65\x78\x61\x6d\x70\x6c\x65\x00\x00\x01\x00\x01\x00\x00\x00\x3c\x00\x04\xc0\x00\x02\x01",
  )
  let result = authenticate_with_key(
    [rr],
    [sig],
    zone,
    key,
    TimePolicy::at(150U),
    Limits::default(),
  ).unwrap()
  assert_eq(result.lifetime(), 30U)
  assert_eq(result.rrtype(), 1)
  let bad = Record::new(zone, 1, 30U, b"\xc0\x00\x02\x02").unwrap()
  assert_true(
    authenticate_with_key(
      [bad],
      [sig],
      zone,
      key,
      TimePolicy::at(150U),
      Limits::default(),
    )
    is Err(Bogus(_)),
  )
  assert_true(
    authenticate_with_key(
      [rr],
      [sig],
      zone,
      key,
      TimePolicy::at(201U),
      Limits::default(),
    )
    is Err(Stale(_)),
  )
}
